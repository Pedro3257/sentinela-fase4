{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sentinela: demonstração guiada",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/demonstrar_vscode.py",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "justMyCode": true,
      "env": {"PYTHONIOENCODING": "utf-8"}
    },
    {
      "name": "Sentinela: CLI demo",
      "type": "debugpy",
      "request": "launch",
      "module": "sentinela",
      "args": ["demo", "--out", "resultados/vscode-cli"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole"
    }
  ]
}
